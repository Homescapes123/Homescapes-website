# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Website enquiries (api/enquiry.ts) are emailed to the studio through Resend.
# Set these in Vercel -> Project -> Settings -> Environment Variables. Never prefix them with VITE_.
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Homescapes Website <enquiries@homescapes.studio>".
# Before the domain is verified, "onboarding@resend.dev" can only send to the Resend account's own email.
ENQUIRY_FROM_EMAIL=
# Optional, defaults to workwithhomescapes@gmail.com
ENQUIRY_TO_EMAIL=
# Local development only: set to 1 to print enquiries to the terminal instead of emailing them.
ENQUIRY_DRY_RUN=

# Optional SMTP Settings for delivering live emails to workwithhomescapes@gmail.com
# Configure these in Settings -> Environment Variables for real email inbox delivery:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
