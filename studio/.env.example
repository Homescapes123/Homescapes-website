# Copy to studio/.env once the business has created its Sanity project (sanity.io/manage).
# These identify the project; they are not secrets.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Subdomain for `sanity deploy`, e.g. "homescapes" -> https://homescapes.sanity.studio
SANITY_STUDIO_HOST=
